                    <mxGeometry x="900" y="210" width="520" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p6_10" value="③ 卸载 AssemblyLoadContext&#xa;Unload()&#xa;→ GC.Collect()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="900" y="330" width="520" height="80" as="geometry"/>
