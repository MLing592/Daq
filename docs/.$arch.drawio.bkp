                </mxCell>
                <mxCell id="p6_5" value="② 创建 AssemblyLoadContext&#xa;(isCollectible: true)&#xa;流式加载 DLL (MemoryStream)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="160" y="200" width="520" height="80" as="geometry"/>
